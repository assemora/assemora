{
  "name": "assemora",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript framework and CMS: one application layer for developers, people and AI agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemora/assemora.git"
  },
  "homepage": "https://github.com/assemora/assemora#readme",
  "bugs": {
    "url": "https://github.com/assemora/assemora/issues"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "lint": "biome check .",
    "format": "biome check --write .",
    "boundaries": "node --disable-warning=ExperimentalWarning scripts/check-boundaries.ts",
    "clean": "turbo run clean && rm -rf .turbo",
    "verify": "pnpm boundaries && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:types",
    "demo": "pnpm build && pnpm --filter @assemora/example-company dev",
    "dev": "pnpm build && pnpm --filter @assemora/playground --filter @assemora/studio --parallel run dev",
    "test:integration": "vitest run tests/integration"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.6.4",
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
