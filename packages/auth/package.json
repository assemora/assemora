{
  "name": "@assemora/auth",
  "version": "0.0.0",
  "description": "Users, sessions, roles, permissions, policies, tokens",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemora/assemora.git",
    "directory": "packages/auth"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@assemora/schema": "workspace:*",
    "@assemora/core": "workspace:*",
    "@assemora/data": "workspace:*",
    "@node-rs/argon2": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@assemora/database": "workspace:*"
  }
}
