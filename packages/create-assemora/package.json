{
  "name": "create-assemora",
  "version": "0.1.0",
  "description": "Scaffold an Assemora project: pnpm create assemora my-project",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemora/assemora.git",
    "directory": "packages/create-assemora"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "bin": {
    "create-assemora": "./bin.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin.mjs",
    "dist",
    "!dist/.tsbuildinfo",
    "templates"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node --disable-warning=ExperimentalWarning scripts/copy-templates.mjs",
    "clean": "rm -rf dist templates *.tsbuildinfo"
  }
}
