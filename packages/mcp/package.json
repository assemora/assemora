{
  "name": "@assemora/mcp",
  "version": "0.0.0",
  "description": "MCP server, agent API, dry run and change sets",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@assemora/schema": "workspace:*",
    "@assemora/core": "workspace:*",
    "@assemora/resources": "workspace:*",
    "@assemora/pages": "workspace:*"
  }
}
