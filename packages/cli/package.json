{
  "name": "@assemora/cli",
  "version": "0.2.2",
  "description": "Assemora CLI: generators, migrations, introspection",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemora/assemora.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "bin": {
    "assemora": "./bin.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin.mjs",
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@assemora/core": "workspace:*",
    "@assemora/data": "workspace:*",
    "@assemora/database": "workspace:*",
    "@assemora/database-postgres": "workspace:*",
    "@assemora/openapi": "workspace:*",
    "@assemora/schema": "workspace:*",
    "@assemora/sdk": "workspace:*",
    "create-assemora": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
