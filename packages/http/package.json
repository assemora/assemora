{
  "name": "@assemora/http",
  "version": "0.0.0",
  "description": "HTTP layer and route DSL (Fastify inside, never exposed)",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@assemora/schema": "workspace:*",
    "@assemora/core": "workspace:*",
    "fastify": "5.12.1",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
