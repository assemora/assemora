{
  "name": "@assemora/studio",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemora/assemora.git",
    "directory": "apps/studio"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "ASSEMORA_STUDIO_BASE=/studio/ vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:root": "vite build"
  },
  "dependencies": {
    "@assemora/react": "workspace:*",
    "@assemora/schema": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.102.5",
    "@tanstack/react-router": "1.170.32",
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  },
  "description": "Assemora Studio: the visual application, served beside an application it does not know",
  "exports": {
    "./assets": {
      "types": "./assets.d.ts",
      "import": "./assets.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "assets.js",
    "assets.d.ts"
  ]
}
