{
  "name": "@assemora/playground",
  "version": "0.0.0",
  "private": true,
  "description": "A running Assemora application: the API Studio is developed against",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemora/assemora.git",
    "directory": "apps/playground"
  },
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@assemora/auth": "workspace:*",
    "@assemora/core": "workspace:*",
    "@assemora/data": "workspace:*",
    "@assemora/database": "workspace:*",
    "@assemora/http": "workspace:*",
    "@assemora/media": "workspace:*",
    "@assemora/openapi": "workspace:*",
    "@assemora/pages": "workspace:*",
    "@assemora/resources": "workspace:*",
    "@assemora/revisions": "workspace:*",
    "@assemora/schema": "workspace:*",
    "@assemora/react": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2"
  }
}
