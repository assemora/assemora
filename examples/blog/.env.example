# Copy what you need into .env.
#
# .env is gitignored, and it is also where the seed *writes*: a first boot on an
# in-memory database puts a generated ASSEMORA_SEED_PASSWORD in it rather than on
# stdout, because stdout is the log aggregator. Lines you wrote by hand are kept.

# Without it the example runs on an in-memory database: everything works, nothing
# survives a restart, and it says so on every boot.
DATABASE_URL=postgres://localhost:5432/assemora_example_blog

# What the server listens on. 3000 when it is not set.
PORT=3000

# The password the seed gives the accounts it creates.
#
# Leave it unset and the seed generates one and writes it back here. Set it, and
# `pnpm seed` uses it — which is how a real database is seeded, because `pnpm dev`
# and `pnpm start` only ever seed the in-memory fallback.
# ASSEMORA_SEED_PASSWORD=
