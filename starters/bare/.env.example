# Every variable this project reads. Copy what you need into .env.
#
# .env is gitignored, and it is also where the seed *writes*: the first boot on an
# in-memory database puts a generated ASSEMORA_SEED_PASSWORD in it rather than on
# stdout, because stdout is the log aggregator. Lines you wrote by hand are kept.

# The database.
#
# Without it the application falls back to an in-memory adapter: everything works and
# nothing survives a restart. It says so on every boot, so you will not find out later.
DATABASE_URL=postgres://localhost:5432/my_project

# What the server listens on. 3000 when it is not set.
PORT=3000

# The password the seed gives the administrator it creates.
#
# Leave it unset and the seed generates one and writes it back here. Set it, and
# `pnpm seed` uses it — which is how the first administrator on a real database is
# created, because `pnpm dev` and `pnpm start` never seed one.
# ASSEMORA_SEED_PASSWORD=
