# Every variable this project reads. Copy what you need into .env.
#
# One file, two processes: `assemora dev` reads the first two, `next dev` reads the
# last two. Node 24 loads .env for both.

# The database.
#
# Without it the application falls back to an in-memory adapter: everything works and
# nothing survives a restart. It says so on every boot, so you will not find out later.
DATABASE_URL=postgres://localhost:5432/my_project

# What the application listens on. 4000 when it is not set, because Next.js has 3000.
PORT=4000

# Where Next.js finds the application. It is the only thing that needs to: a browser
# never reaches this URL, and it should not be public.
ASSEMORA_URL=http://127.0.0.1:4000

# How the Next.js server identifies itself when it reads published content.
#
# A read is denied by default like every other operation, so a server-rendered page
# has to say who is asking. The first boot of `pnpm dev:api` creates this token and
# prints it once; it can read pages and articles and do nothing else.
ASSEMORA_TOKEN=
